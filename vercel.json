{
  "version": 2,
  "public": true,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/api/status", "dest": "/api/status.js" },
    { "src": "/api/vercel-health", "dest": "/api/vercel-health.js" },
    { "src": "/api/bot/connect", "dest": "/api/bot/connect.js" },
    { "src": "/api/bot/disconnect", "dest": "/api/bot/disconnect.js" },
    { "src": "/api/bot/stop", "dest": "/api/bot/stop.js" },
    { "src": "/api/bot/inventory", "dest": "/api/bot/inventory.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
